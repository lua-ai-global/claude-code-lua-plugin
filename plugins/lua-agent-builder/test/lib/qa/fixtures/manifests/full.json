      "graph": {
        "definition": {
          "graph": [
            {
              "type": "conditional",
              "exclusive": false,
              "steps": [
                {
                  "type": "step",
                  "step": {
                    "id": "a",
                    "description": "Branch A"
                  }
                },
                {
                  "type": "step",
                  "step": {
                    "id": "b",
                    "description": "Branch B"
                  }
                }
              ],
              "predicates": [
                {
                  "op": "exists",
                  "path": "initData.a"
                },
                {
                  "op": "notExists",
                  "path": "initData.b"
                }
              ]
            },
