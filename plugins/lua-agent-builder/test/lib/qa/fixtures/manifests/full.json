    {
      "kind": "workflow",
      "name": "refund-review",
      "description": "Reviews a refund request and pays it out after approval.",
      "form": "graph",
      "schedule": {
        "expression": "0 9 * * 1",
        "timezone": "UTC"
      },
      "schemas": {
        "input": {
          "type": "object",
          "properties": {
            "orderId": {
              "type": "string",
              "description": "order"
            },
            "amount": {
              "type": "number"
            }
          },
          "required": [
            "orderId"
          ]
        }
      },
      "envKeys": [
        "PAYMENTS_BASE_URL"
      ],
      "graph": {
        "definition": {
          "inputSchema": {
            "type": "object"
          },
          "graph": [
            {
              "type": "step",
              "step": {
                "id": "load",
                "description": "Load the order"
              },
              "sideEffects": "none"
            },
            {
              "type": "agent",
              "id": "classify",
              "agentId": "agent-1",
              "promptTemplate": "Classify the refund request as small, large or fraud. Be strict about fraud.",
              "requiredConnections": [
                "payments"
              ]
            },
            {
              "type": "conditional",
              "exclusive": true,
              "steps": [
                {
                  "type": "step",
                  "step": {
                    "id": "autoRefund",
                    "description": "Refund automatically"
                  },
                  "sideEffects": "external"
                },
                {
                  "type": "approval",
                  "id": "managerOk",
                  "title": "Manager approves large refund",
                  "onDeny": "continue",
                  "onTimeout": "deny"
                },
                {
                  "type": "tool",
                  "id": "flag",
                  "toolId": "flag_fraud"
                }
              ],
              "predicates": [
                {
                  "op": "eq",
                  "left": {
                    "path": "stepResults.classify.size"
                  },
                  "right": {
                    "literal": "small"
                  }
                },
                {
                  "op": "and",
                  "args": [
                    {
                      "op": "eq",
                      "left": {
                        "path": "stepResults.classify.size"
                      },
                      "right": {
                        "literal": "large"
                      }
                    },
                    {
                      "op": "not",
                      "arg": {
                        "op": "eq",
                        "left": {
                          "path": "stepResults.load.state"
                        },
                        "right": {
                          "literal": "locked"
                        }
                      }
                    }
                  ]
                },
                {
                  "op": "in",
                  "value": {
                    "path": "stepResults.classify.size"
                  },
                  "set": [
                    "fraud",
                    "unknown"
                  ]
                }
              ],
              "otherwise": {
                "type": "step",
                "step": {
                  "id": "noop",
                  "description": "Do nothing"
                }
              }
            },
            {
              "type": "waitForSignal",
              "id": "bankReply",
              "signal": "bank.reply",
              "onTimeout": "continue"
            },
            {
              "type": "parallel",
              "steps": [
                {
                  "type": "tool",
                  "id": "notifyCustomer",
                  "toolId": "send_email",
                  "sideEffects": "external"
                },
                {
                  "type": "workflow",
                  "id": "audit",
                  "workflowId": "audit-log"
                }
              ]
            },
            {
              "type": "foreach",
              "step": {
                "type": "tool",
                "id": "eachLine",
                "toolId": "refund_order"
              },
              "opts": {
                "items": {
                  "path": "x"
                }
              }
            },
            {
              "type": "loop",
              "loopType": "until",
              "step": {
                "type": "step",
                "step": {
                  "id": "poll",
                  "description": "Poll the bank"
                }
              },
              "predicate": {
                "op": "truthy",
                "value": {
                  "path": "stepResults.poll.done"
                }
              },
              "maxIterations": 5
            },
            {
              "type": "sleep",
              "id": "cool",
              "duration": 90000
            },
            {
              "type": "mapping",
              "id": "shape",
              "mapConfig": "{}"
            },
            {
              "type": "exoticNode",
              "id": "mystery"
            }
          ]
        }
      }
    },
