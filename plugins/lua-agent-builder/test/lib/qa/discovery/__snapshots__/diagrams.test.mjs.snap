exports[`branchTreeSvg snapshots of the three diagram kinds: decision-tree 1`] = `"<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 998 718" width="100%" style="max-width:998px" role="img" aria-label="Decision tree for the skill orders" font-family="-apple-system, &#x27;Helvetica Neue&#x27;, Helvetica, Arial, sans-serif"><defs><marker id="arr" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0,0 L10,5 L0,10 z" fill="#62626f"/></marker><marker id="arrO" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0,0 L10,5 L0,10 z" fill="#ff8a00"/></marker><marker id="arrP" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0,0 L10,5 L0,10 z" fill="#f633a2"/></marker><marker id="arrV" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0,0 L10,5 L0,10 z" fill="#995ff8"/></marker><marker id="arrB" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0,0 L10,5 L0,10 z" fill="#0097ff"/></marker></defs><rect x="0" y="0" width="998" height="718" rx="14" fill="#f6f6f8" stroke="#d9d9df"/><text x="24" y="30" font-family="ui-monospace, &#x27;SF Mono&#x27;, Menlo, Consolas, monospace" font-size="9.5" font-weight="600" fill="#62626f" text-anchor="start" letter-spacing="2">WHICH TOOL DOES ORDERS CALL?</text><path d="M254,358 L278,358 L278,78 L382,78" stroke="#0097ff" stroke-width="1.4" fill="none" marker-end="url(#arrB)"/><text x="284" y="73" font-family="-apple-system, &#x27;Helvetica Neue&#x27;, Helvetica, Arial, sans-serif" font-size="9.5" font-weight="600" fill="#62626f" text-anchor="start" letter-spacing="0">always</text><path d="M614,183 L638,183 L638,148 L742,148" stroke="#0097ff" stroke-width="1.4" fill="none" marker-end="url(#arrB)"/><text x="644" y="143" font-family="-apple-system, &#x27;Hel