exports[`branchTreeSvg snapshots of the three diagram kinds: flow 1`] = `"<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1120 588" width="100%" style="max-width:1120px" role="img" aria-label="Flow of sample-support: user, processors, skills and tools" font-family="-apple-system, &#x27;Helvetica Neue&#x27;, Helvetica, Arial, sans-serif"><defs><marker id="arr" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0,0 L10,5 L0,10 z" fill="#62626f"/></marker><marker id="arrO" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0,0 L10,5 L0,10 z" fill="#ff8a00"/></marker><marker id="arrP" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0,0 L10,5 L0,10 z" fill="#f633a2"/></marker><marker id="arrV" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0,0 L10,5 L0,10 z" fill="#995ff8"/></marker><marker id="arrB" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0,0 L10,5 L0,10 z" fill="#0097ff"/></marker></defs><rect x="0" y="0" width="1120" height="588" rx="14" fill="#f6f6f8" stroke="#d9d9df"/><text x="24" y="32" font-family="ui-monospace, &#x27;SF Mono&#x27;, Menlo, Consolas, monospace" font-size="9.5" font-weight="600" fill="#62626f" text-anchor="start" letter-spacing="2">HOW SAMPLE-SUPPORT HANDLES A MESSAGE</text><rect x="16" y="50" width="1088" height="252" rx="10" fill="#eeeef2" stroke="none" stroke-width="1"/><rect x="30" y="150" width="96" height="52" rx="9" fill="#ffffff" stroke="#f633a2" stroke-width="1.6"/><rect x="30" y="150" width="5" height="52" rx="2.5" fill="#f633a2"/><text x="44" y="169" font-family="-apple-system, &#x27;Helvetica Neue&#x27;, Helvetica, Arial, sans-serif" font-size="12.5" font-weight="600" fill="#0a0a0b" text-anchor="start" letter-spacing="0">User</tex