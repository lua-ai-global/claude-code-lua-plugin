# MCP server build output (esbuild-bundled, minified)
mcp/*/dist/

# MCP server's own node_modules and tests (linted by their own pipeline)
mcp/*/node_modules/
mcp/*/coverage/

# Coverage output
coverage/

# Plugin node_modules (default, but explicit)
node_modules/

# Workflow tool scripts (top-level return; run by the Workflow tool, tested via test/lib/qa/workflow/template.test.mjs)
lib/qa/workflow/*.js
